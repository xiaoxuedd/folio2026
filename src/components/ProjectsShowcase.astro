---
import type { Project } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// The two flagship projects anchor a large 2-up row; the rest fill a 3-up row.
const featured = projects.slice(0, 2);
const rest = projects.slice(2);
---

<section id="works" class="projects-section">
  <div class="container">
    <header class="section-head" data-aos="fade-up">
      <h2 class="section-heading">Selected works</h2>
    </header>

    {featured.length > 0 && (
      <div class="projects-grid projects-grid--featured">
        {featured.map((project, index) => (
          <ProjectCard project={project} index={index} featured />
        ))}
      </div>
    )}

    {rest.length > 0 && (
      <div class="projects-grid projects-grid--rest">
        {rest.map((project, index) => (
          <ProjectCard project={project} index={index + featured.length} />
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .projects-section {
    background: var(--color-bg);
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }

  .section-head {
    margin-bottom: var(--gap-2xl);
  }

  .section-heading {
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
    margin: 0;
  }

  .projects-grid {
    display: grid;
    gap: var(--gap-lg);
  }

  /* minmax(0, 1fr) lets tracks shrink below content min-width, so the grid
     reflows cleanly on narrow viewports instead of overflowing. */
  .projects-grid--featured {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: var(--gap-2xl);
  }

  .projects-grid--rest {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 960px) {
    .projects-grid--rest {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap-lg);
    }
  }

  @media (max-width: 600px) {
    .projects-grid--featured,
    .projects-grid--rest {
      grid-template-columns: 1fr;
      gap: var(--gap-2xl);
    }
  }
</style>
