---
import type { ExpertiseArea } from '../data/expertise';

interface Props {
  expertiseAreas: ExpertiseArea[];
}

const { expertiseAreas } = Astro.props;
---

<div class="craft-accordion" data-accordion>
  {expertiseAreas.map((area, index) => (
    <div class="accordion-item" data-accordion-item>
      <button
        class="accordion-header"
        data-accordion-trigger
        aria-expanded={index === 0 ? 'true' : 'false'}
      >
        <span class="accordion-title">{area.title}</span>
        <span class="accordion-icon" aria-hidden="true">
          <span class="accordion-icon__bar accordion-icon__bar--h"></span>
          <span class="accordion-icon__bar accordion-icon__bar--v"></span>
        </span>
      </button>
      <div class="accordion-content" data-accordion-content class:list={[{ 'is-open': index === 0 }]}>
        <div class="accordion-panel">
          {area.description.split('\n').map((para) => para && <p>{para}</p>)}
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .craft-accordion {
    width: 100%;
  }

  .accordion-item {
    border-top: 1px solid var(--color-border);
  }

  .accordion-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .accordion-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap-md);
    padding: var(--gap-lg) 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .accordion-title {
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .accordion-header:hover .accordion-title,
  .accordion-header[aria-expanded='true'] .accordion-title {
    color: var(--color-primary);
  }

  .accordion-header:hover .accordion-title {
    transform: translateX(4px);
  }

  /* Plus / minus toggle */
  .accordion-icon {
    position: relative;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .accordion-header:hover .accordion-icon,
  .accordion-header[aria-expanded='true'] .accordion-icon {
    color: var(--color-primary);
  }

  .accordion-icon__bar {
    position: absolute;
    top: 50%;
    left: 50%;
    background: currentColor;
    border-radius: var(--radius-full);
  }

  .accordion-icon__bar--h {
    width: 18px;
    height: 2px;
    transform: translate(-50%, -50%);
  }

  .accordion-icon__bar--v {
    width: 2px;
    height: 18px;
    transform: translate(-50%, -50%);
    transition: transform var(--transition-fast);
  }

  /* Collapse the vertical bar → minus when open */
  .accordion-header[aria-expanded='true'] .accordion-icon__bar--v {
    transform: translate(-50%, -50%) scaleY(0);
  }

  .accordion-content {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .accordion-content.is-open {
    grid-template-rows: 1fr;
  }

  .accordion-panel {
    min-height: 0;
    overflow: hidden;
    padding-bottom: 0;
    opacity: 0;
    transition: opacity 0.25s ease, padding 0.35s ease;
  }

  .accordion-content.is-open .accordion-panel {
    opacity: 1;
    padding-bottom: var(--gap-lg);
  }

  .accordion-panel p {
    font-size: var(--font-size-body-1);
    line-height: var(--line-height-body);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .accordion-panel p + p {
    margin-top: var(--gap-md);
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-content,
    .accordion-panel,
    .accordion-title {
      transition: none;
    }
  }
</style>

<script>
  import { trackEvent } from '../utils/analytics';

  function setupAccordion() {
    document.querySelectorAll('[data-accordion]').forEach((accordion) => {
      const items = Array.from(accordion.querySelectorAll('[data-accordion-item]'));

      const open = (item: Element) => {
        items.forEach((other) => {
          const trigger = other.querySelector('[data-accordion-trigger]');
          const content = other.querySelector('[data-accordion-content]');
          if (!trigger || !content) return;
          const isTarget = other === item;
          trigger.setAttribute('aria-expanded', isTarget ? 'true' : 'false');
          content.classList.toggle('is-open', isTarget);
        });
      };

      // Hover opens nothing — the panels are tall, so a hover-driven open
      // makes the page jump as the pointer crosses items. Click only.
      items.forEach((item) => {
        const trigger = item.querySelector('[data-accordion-trigger]');
        const content = item.querySelector('[data-accordion-content]');
        if (!trigger || !content) return;

        trigger.addEventListener('click', () => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          if (isOpen) {
            trigger.setAttribute('aria-expanded', 'false');
            content.classList.remove('is-open');
          } else {
            open(item);
            const title = item.querySelector('.accordion-title')?.textContent?.trim();
            if (title) trackEvent('expertise_open', { title });
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAccordion);
  } else {
    setupAccordion();
  }
</script>
