---
import type { Project } from '../data/projects';
import { getImage } from 'astro:assets';

interface Props {
  project: Project;
  index: number;
  featured?: boolean;
}

const { project, index, featured = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const hasLink = Boolean(project.link);
const Tag = hasLink ? 'a' : 'div';

let imageSrc: string;
let imageSrcset: string | undefined;
let imageWidth: number | undefined;
let imageHeight: number | undefined;

if (typeof project.image === 'string') {
  imageSrc = `${baseUrl}${project.image}`.replace(/\/\//g, '/');
} else {
  const sizes = [{ width: 960 }, { width: 720 }, { width: 480 }];
  const processed = await Promise.all(
    sizes.map((size) =>
      getImage({
        src: project.image,
        format: 'webp',
        quality: 80,
        width: size.width,
      })
    )
  );
  imageSrc = processed[0].src;
  imageSrcset = processed.map((img, i) => `${img.src} ${sizes[i].width}w`).join(', ');
  imageWidth = processed[0].attributes.width;
  imageHeight = processed[0].attributes.height;
}

const overlayStatement = project.overlayBody ?? project.overlaySubtitle ?? project.shortDescription ?? project.description;
const statusTag = hasLink ? 'Case study' : 'Coming soon';
const imageSizes = featured
  ? '(max-width: 600px) 100vw, 50vw'
  : '(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw';
---

<Tag
  href={hasLink ? `${baseUrl}${project.link}`.replace(/\/\//g, '/') : undefined}
  class:list={['project-tile', { 'project-tile--featured': featured, 'project-tile--linked': hasLink }]}
  data-aos="fade-up"
  data-aos-delay={Math.min(index * 80, 240)}
  data-project-title={project.title}
  data-project-category={project.category}
  data-project-link={project.link ?? ''}
>
  <div class="project-tile__media">
    <img
      class="project-tile__image"
      src={imageSrc}
      srcset={imageSrcset}
      sizes={imageSizes}
      alt={project.title}
      loading="lazy"
      width={imageWidth}
      height={imageHeight}
    />

    {project.category && <span class="project-tile__tag">{statusTag}</span>}

    <div class="project-tile__overlay"></div>

    <div class="project-tile__copy">
      {project.overlaySubtitle && <p class="project-tile__tagline">{project.overlaySubtitle}</p>}
      {project.overlayBody && <p class="project-tile__statement">{project.overlayBody}</p>}
    </div>
  </div>

  <div class="project-tile__meta">
    <h3 class="project-tile__title">{project.title}</h3>
    {project.industry && <p class="project-tile__sub">{project.industry}</p>}
  </div>
</Tag>

<style>
  .project-tile {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    /* Allow the tile to shrink inside 1fr grid tracks — without this the
       image's intrinsic width pins the track and the grid overflows on
       narrow screens (looks like it won't resize live). */
    min-width: 0;

    /* Reveal motion, local to the tile: ease-out-quint feel at 450ms. No token
       matches (--transition-normal overshoots, --transition-slow is linear ease),
       and the frost/copy stagger needs a shared duration. */
    --tile-reveal-dur: 0.45s;
    --tile-reveal-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --tile-copy-delay: 0.06s;
  }

  .project-tile--linked {
    cursor: pointer;
  }

  .project-tile__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .project-tile--featured .project-tile__media {
    aspect-ratio: 4 / 3;
  }

  .project-tile__image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .project-tile:hover .project-tile__image {
      transform: scale(1.04);
    }
  }

  /* Glass status pill — rounded form is an intentional exception to the sharp
     grid. Always visible (it labels the tile, so it can't be hover-gated). */
  .project-tile__tag {
    position: absolute;
    top: var(--gap-lg);
    left: var(--gap-lg);
    z-index: 3;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: var(--frost-chip-bg);
    backdrop-filter: blur(var(--blur-menu));
    -webkit-backdrop-filter: blur(var(--blur-menu));
    border: 1px solid color-mix(in srgb, var(--frost-heading) 10%, transparent);
    color: var(--frost-chip-text);
    font-size: var(--font-size-ui-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  /* Frost + corner glow. Contrast comes from --frost-fill, not the blur, so
     this degrades safely where backdrop-filter is unsupported. */
  .project-tile__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    backdrop-filter: blur(var(--frost-blur)) saturate(1.35);
    -webkit-backdrop-filter: blur(var(--frost-blur)) saturate(1.35);
    background:
      radial-gradient(circle at 12% 8%, var(--frost-glow-mint), transparent 52%),
      radial-gradient(circle at 90% 96%, var(--frost-glow-violet), transparent 55%),
      var(--frost-fill);
    opacity: 0;
    transition: opacity var(--tile-reveal-dur) var(--tile-reveal-ease);
  }

  /* Text layer is separate from the frost so it can stagger in behind it. */
  .project-tile__copy {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-md);
    padding: calc(var(--gap-lg) + var(--gap-xl)) var(--gap-xl) var(--gap-xl);
    text-align: center;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity var(--tile-reveal-dur) var(--tile-reveal-ease) var(--tile-copy-delay),
      transform var(--tile-reveal-dur) var(--tile-reveal-ease) var(--tile-copy-delay);
  }

  /* Keyboard focus mirrors hover — the copy is never hover-only. */
  .project-tile:focus-visible .project-tile__overlay,
  .project-tile:focus-within .project-tile__overlay,
  .project-tile:focus-visible .project-tile__copy,
  .project-tile:focus-within .project-tile__copy {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: hover) {
    .project-tile:hover .project-tile__overlay,
    .project-tile:hover .project-tile__copy {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Touch: no hover state to enter, so the copy is shown by default rather
     than left unreachable. */
  @media (hover: none) {
    .project-tile__overlay,
    .project-tile__copy {
      opacity: 1;
      transform: none;
    }
  }

  .project-tile__tagline {
    margin: 0;
    flex-shrink: 0;
    color: var(--frost-heading);
    font-size: var(--font-size-h5);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-headings);
    letter-spacing: -0.02em;
  }

  .project-tile__statement {
    margin: 0;
    flex-shrink: 1;
    min-height: 0;
    color: var(--frost-body);
    font-size: var(--font-size-body-xs);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-body);
    display: -webkit-box;
    -webkit-line-clamp: 10;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-tile__meta {
    padding-top: var(--gap-lg);
  }

  .project-tile__title {
    margin: 0 0 4px;
    color: var(--color-text);
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    letter-spacing: -0.01em;
    transition: color var(--transition-fast);
  }

  @media (hover: hover) {
    .project-tile--linked:hover .project-tile__title {
      color: var(--color-primary);
    }
  }

  .project-tile__sub {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-1);
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Plain short fade, no drift and no stagger. */
    .project-tile__overlay,
    .project-tile__copy {
      transition: opacity 0.2s linear;
      transform: none;
    }

    .project-tile__image {
      transition: none;
    }

    .project-tile:hover .project-tile__image {
      transform: none;
    }
  }
</style>

<script>
  import { trackEvent } from '../utils/analytics';

  function setupProjectTracking() {
    const tiles = document.querySelectorAll('a.project-tile');
    tiles.forEach((tile) => {
      tile.addEventListener('click', () => {
        const title = tile.getAttribute('data-project-title');
        const category = tile.getAttribute('data-project-category');
        const link = tile.getAttribute('data-project-link');
        if (title) {
          trackEvent('project_click', {
            project_title: title,
            project_category: category,
            project_link: link,
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProjectTracking);
  } else {
    setupProjectTracking();
  }
</script>
