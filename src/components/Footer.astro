---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__row">
    <p class="site-footer__copy">&copy; {year} Design Doings Ltd</p>

    <p class="site-footer__credit">Co-crafted by Xiaoxue and her AI partner</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-inverse);
    border-top: 1px solid color-mix(in srgb, var(--color-text-inverse) 10%, transparent);
    padding: var(--gap-xl) 0;
    margin-top: auto;
    flex-shrink: 0;
  }

  .site-footer__row {
    display: flex;
    align-items: center;
    gap: var(--gap-xl);
    flex-wrap: wrap;
    font-size: var(--font-size-ui-sm);
    color: color-mix(in srgb, var(--color-text-inverse) 50%, transparent);
  }

  .site-footer__copy,
  .site-footer__credit {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-inverse) 50%, transparent);
  }

  .site-footer__credit {
    margin-left: auto;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .site-footer__row {
      gap: var(--gap-md);
      justify-content: center;
      text-align: center;
    }

    .site-footer__credit {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
