---
import HeroText from './HeroText';
import RadialDiagram from './RadialDiagram';
import { getImage } from 'astro:assets';
import xiaoxueAvatar from '../images/xiaoxue-photo-2.jpeg';

const avatar = await getImage({
  src: xiaoxueAvatar,
  format: 'webp',
  width: 128,
  height: 128,
  quality: 85,
});
---

<section id="home" class="hero">
  <div class="hero-panel">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-left">
          <RadialDiagram client:load />
        </div>

        <div class="hero-right">
          <HeroText client:load avatarSrc={avatar.src} avatarAlt="Xiaoxue Dong" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: var(--spacing-lg) 0 var(--spacing-md);
    background: var(--color-bg);
  }

  /* Soft neutral panel surrounds the whole hero — diagram on the left,
     hero text on the right. The bg + grid live on a ::before pseudo-element
     so the edges can fade via mask-image while content stays sharp. */
  .hero-panel {
    position: relative;
    width: 100%;
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    isolation: isolate;
  }

  .hero-panel::before {
    content: '';
    position: absolute;
    /* Constrain to roughly the container content width */
    inset: 0 max(0px, calc((100% - var(--max-width)) / 2));
    z-index: -1;
    background-color: var(--color-bg);
    background-image:
      linear-gradient(to right, var(--color-grid-mark) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-grid-mark) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: 14px 14px;
    /* Short feather on all four edges of the constrained box */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 6rem, #000 calc(100% - 6rem), transparent),
      linear-gradient(to bottom, transparent, #000 6rem, #000 calc(100% - 6rem), transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 6rem, #000 calc(100% - 6rem), transparent),
      linear-gradient(to bottom, transparent, #000 6rem, #000 calc(100% - 6rem), transparent);
    mask-composite: intersect;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-lg);
    align-items: center;
    width: 100%;
  }

  @media (min-width: 1440px) {
    .hero-grid {
      gap: var(--gap-lg);
    }
  }

  .hero-left {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
  }

  .hero-right {
    width: 100%;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      /* Generous top padding to clear the fixed navbar — the eyebrow
         was hiding behind it before. */
      padding: clamp(6rem, 16vw, 9rem) 0 var(--spacing-lg);
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--gap-xl);
      justify-items: center;
    }

    /* Diagram is desktop-only — hides cleanly on narrower screens. */
    .hero-left {
      display: none;
    }

    .hero-right {
      max-width: 560px;
      text-align: center;
    }
  }

  @media (max-width: 600px) {
    .hero-panel {
      padding: clamp(1.75rem, 6vw, 2.5rem) 0;
    }
  }
</style>
