---
import 'aos/dist/aos.css';
// Self-hosted fonts
import '@fontsource/manrope/300.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/cormorant-garamond/400-italic.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Service designer & strategist based in London. Driving positive change through strategic design across healthcare, finance, retail, and social services.",
  image = "/images/og-image.png",
  noindex = false
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://designdoings.com';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Xiaoxue Dong',
  jobTitle: 'Service Designer & Strategist',
  url: siteUrl,
  image: ogImage.toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'London',
    addressCountry: 'GB'
  },
  email: 'mailto:xiaoxue.sherryd@gmail.com',
  sameAs: [
    'https://www.linkedin.com/in/xiaoxued/'
  ]
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Design Doings',
  url: siteUrl,
  author: {
    '@type': 'Person',
    name: 'Xiaoxue Dong'
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes"/>
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href={`${baseUrl}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${baseUrl}android-chrome-192x192.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${baseUrl}android-chrome-512x512.png`} />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-1H1K7GE6J0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1H1K7GE6J0');
    </script>
  </head>
  <body>
    <div class="nav-fade-overlay"></div>
    <main>
      <slot />
    </main>
    <script>
      import AOS from 'aos';
      import { aosConfig } from '../config/aos';
      AOS.init(aosConfig);
    </script>
    <script is:inline>
      // Theme switching logic
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const setTheme = (theme) => {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
      };

      // Set theme immediately to avoid flash
      setTheme(getThemePreference());

      // Listen for theme toggle events
      document.addEventListener('DOMContentLoaded', () => {
        window.toggleTheme = () => {
          const currentTheme = document.documentElement.getAttribute('data-theme');
          const newTheme = currentTheme === 'light' ? 'dark' : 'light';
          setTheme(newTheme);
        };
      });
    </script>
    <script is:inline>
      // Safari's bottom rubber-band reveals the canvas (the <html> background),
      // which is light in light mode — an ugly white strip under the always-dark
      // footer. Flip the canvas to the footer's dark only while scrolled to the
      // bottom, so a pull-down at the top still reveals the normal light bg.
      (function () {
        let maxScroll = 0;
        let atBottom = false;
        const measure = () => {
          maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        };
        const update = () => {
          const nearBottom = maxScroll > 0 && window.scrollY >= maxScroll - 4;
          if (nearBottom === atBottom) return;
          atBottom = nearBottom;
          document.documentElement.style.backgroundColor = nearBottom
            ? 'var(--color-bg-inverse)'
            : '';
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', () => { measure(); update(); }, { passive: true });
        // Page height shifts after load (e.g. the CTA sets its wrapper height in
        // JS) — keep maxScroll fresh via RO so the scroll path never reflows.
        if ('ResizeObserver' in window) {
          new ResizeObserver(() => { measure(); update(); }).observe(document.body);
        }
        measure();
        update();
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* ============================================
       SEMANTIC COLOUR TOKENS — Electric Mint
       Single accent, cool-grey neutrals (purple tint).
       ============================================ */

    /* -- Canonical semantic tokens -- */
    --bg:        #FFFFFF;
    --surface:   #F8F8FC;
    --surface-2: #EFEFF7;
    --border:    #DCDCE8;
    --text:      #1C1A38;
    --text-2:    #6E6B8A;
    --text-3:    #A8A6BD;
    --accent:    #0A7A58;         /* mint-700 — 5.2:1 AA on white */
    --accent-h:  #086645;         /* hover / pressed */
    --accent-bg: #EDFAF4;         /* mint-50 tint background */
    --glass:     rgba(255,255,255,.82);
    --project:   #5B3CEE;         /* project-scoped only — case studies */

    /* -- Backward-compatible aliases (used by existing components) -- */
    --color-bg:                   var(--bg);
    --color-bg-secondary:         var(--surface);
    --color-text:                 var(--text);
    --color-text-secondary:       var(--text-2);
    --color-text-light:           var(--text);
    --color-border:               var(--border);
    --color-border-alpha:         rgba(220,220,232,.6);
    --color-hover-bg:             rgba(28,26,56,.04);
    --color-accent-coral:         var(--accent);
    --color-accent-coral-hover:   var(--accent-h);
    --color-accent-indigo:        var(--project);
    --color-primary:              var(--accent);
    --color-secondary:            var(--project);
    --color-accent:               var(--text);  /* nav/footer contrast surfaces */
    --color-primary-alpha-light:  rgba(10,122,88,.08);
    --color-primary-alpha-medium: rgba(10,122,88,.12);

    /* Inverse surface — permanently-dark sections (ContactCTA), theme-independent */
    --color-bg-inverse:   #0A0812;
    --color-text-inverse: #F0EFF8;

    /* Hero diagram surfaces */
    --color-pill-neutral-bg: var(--surface-2);
    --color-grid-mark:       var(--border);

    /* Gold / icterine — legacy case-study accents */
    --color-gold:                 #F3D700;
    --color-gold-alpha-light:     rgba(243,215,0,.10);
    --color-gold-alpha-medium:    rgba(243,215,0,.25);
    --color-gold-alpha-strong:    rgba(243,215,0,.40);
    --color-icterine:             #FCFF61;
    --color-icterine-alpha-light:  rgba(252,255,97,.10);
    --color-icterine-alpha-medium: rgba(252,255,97,.25);
    --color-icterine-alpha-strong: rgba(252,255,97,.40);

    /* Icon colours */
    --color-icon-bg:     var(--surface-2);
    --color-icon-stroke: var(--text);

    /* Icon sizes */
    --icon-xs:  16px;
    --icon-sm:  20px;
    --icon-md:  24px;
    --icon-lg:  32px;
    --icon-xl:  40px;
    --icon-2xl: 48px;
    --icon-3xl: 64px;

    /* ============================================
       LAYOUT
       ============================================ */
    /* Fluid so the nav pill + content column grow smoothly on wide screens
       instead of snapping 200px wider at a hard breakpoint. Pinned at 1100px
       up to ~1500px viewport, then ramps to 1300px by ~1900px. */
    --max-width: clamp(1100px, 50vw + 350px, 1300px);

    --text-width-single:     900px;
    --text-width-column:     500px;
    --content-width-narrow:  800px;
    --content-width-reading: 900px;
    --content-width-wide:   1400px;

    /* ============================================
       SPACING — 8px grid
       ============================================ */
    --spacing-xs:  0.5rem;   /* 8px */
    --spacing-sm:  1rem;     /* 16px */
    --spacing-md:  2rem;     /* 32px */
    --spacing-lg:  4rem;     /* 64px */
    --spacing-xl:  8rem;     /* 128px */
    --spacing-2xl: 12rem;    /* 192px */

    /* Gap tokens */
    --gap-tight: 0.125rem;  /* 2px */
    --gap-xs:    0.25rem;   /* 4px */
    --gap-sm:    0.5rem;    /* 8px */
    --gap-md:    1rem;      /* 16px */
    --gap-lg:    1.5rem;    /* 24px */
    --gap-xl:    2.5rem;    /* 40px */
    --gap-2xl:   4rem;      /* 64px */
    --gap-3xl:   6.75rem;   /* 108px */

    /* ============================================
       OPACITY
       ============================================ */
    --opacity-subtle:  .10;
    --opacity-light:   .20;
    --opacity-medium:  .40;
    --opacity-visible: .60;
    --opacity-strong:  .70;

    /* ============================================
       TYPOGRAPHY — sizes
       ============================================ */
    --font-size-h0: 4.25rem;                            /* 68px: hero display */
    --font-size-h1: 3.25rem;                            /* 52px */
    --font-size-h2: 2.5rem;                             /* 40px */
    --font-size-h3: 2rem;                               /* 32px */
    --font-size-h4: clamp(1.25rem, 3vw, 1.5rem);       /* 20–24px */
    --font-size-h5: 1.25rem;                            /* 20px */
    --font-size-h6: 1rem;                               /* 16px */

    --font-size-body-0:  1.125rem;  /* 18px: lead / large body */
    --font-size-body-1:  1rem;      /* 16px: default body */
    --font-size-body-lg: 1.25rem;   /* legacy alias */
    --font-size-body:    1.125rem;  /* legacy alias */
    --font-size-body-sm: 1rem;      /* legacy alias */
    --font-size-body-xs: 0.875rem;  /* 14px */

    --font-size-ui-lg: 1rem;        /* 16px */
    --font-size-ui:    0.9375rem;   /* 15px */
    --font-size-ui-sm: 0.875rem;    /* 14px */
    --font-size-ui-xs: 0.75rem;     /* 12px */

    --font-size-display-lg: clamp(2.5rem, 5vw, 4.25rem);
    --font-size-display-md: clamp(2rem, 4vw, 3.5rem);
    --font-size-display-sm: clamp(2rem, 4vw, 3rem);

    /* ============================================
       TYPOGRAPHY — weights / line-heights / tracking
       ============================================ */
    --font-weight-regular:  300;  /* Inter 300 — light-first body */
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    --line-height-hero:     1.0;
    --line-height-headings: 1.15;
    --line-height-body:     1.65;
    --line-height-tight:    1.15;
    --line-height-normal:   1.5;
    --line-height-relaxed:  1.7;
    --line-height-loose:    1.8;

    --letter-spacing-tight:  -0.03em;
    --letter-spacing-normal:  0;
    --letter-spacing-wide:    0.10em;

    /* ============================================
       BORDER RADIUS
       ============================================ */
    --radius-xs:   2px;
    --radius-sm:   6px;
    --radius-md:   8px;
    --radius-lg:   16px;
    --radius-xl:   20px;
    --radius-2xl:  20px;
    --radius-3xl:  24px;
    --radius-pill: 9999px;
    --radius-full: 9999px;

    /* ============================================
       BORDERS
       ============================================ */
    --border-divider: 1px solid var(--border);

    /* ============================================
       TRANSITIONS
       ============================================ */
    --transition-fast:   0.15s ease;
    --transition-normal: 0.28s cubic-bezier(.22,.68,0,1.2);
    --transition-slow:   0.5s ease;

    /* ============================================
       SHADOWS
       ============================================ */
    --shadow-sm:    0 1px 2px rgba(28,26,56,.04);
    --shadow-md:    0 4px 12px rgba(28,26,56,.07);
    --shadow-lg:    0 8px 24px rgba(28,26,56,.10);
    --shadow-hover: 0 6px 16px rgba(28,26,56,.12);
    --shadow-glow:  rgba(10,122,88,.15);

    /* ============================================
       BLUR
       ============================================ */
    --blur-glass:   20px;
    --blur-menu:    10px;
    --blur-overlay: 10px;
  }

  [data-theme="dark"] {
    --bg:        #0A0812;
    --surface:   #12101E;
    --surface-2: #1C1A2E;
    --border:    rgba(53,51,84,.85);
    --text:      #F0EFF8;
    --text-2:    #8B89A5;
    --text-3:    #514E6E;
    --accent:    #24D48E;         /* mint-400 — 10.9:1 AAA on dark bg */
    --accent-h:  #3BEBA0;
    --accent-bg: rgba(36,212,142,.12);
    --glass:     rgba(10,8,18,.86);
    --project:   #7B63F5;

    /* Recomputed backward-compat overrides */
    --color-border-alpha:         rgba(53,51,84,.50);
    --color-hover-bg:             rgba(255,255,255,.04);
    --color-primary-alpha-light:  rgba(36,212,142,.10);
    --color-primary-alpha-medium: rgba(36,212,142,.16);

    --shadow-sm:    0 1px 2px rgba(0,0,0,.30);
    --shadow-md:    0 4px 12px rgba(0,0,0,.40);
    --shadow-lg:    0 8px 24px rgba(0,0,0,.45);
    --shadow-hover: 0 6px 16px rgba(0,0,0,.50);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .nav-fade-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, var(--bg) 0%, var(--bg) 30%, transparent 100%);
    pointer-events: none;
    z-index: 998;
    transition: background 0.3s ease;
  }

  html {
    scroll-behavior: smooth;
    height: 100%;
    scroll-padding-top: 100px;
    scrollbar-gutter: stable;
  }

  /* Respect users' motion preferences */
  @media screen and (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 300;
    color: var(--color-text-secondary);
    background: var(--color-bg);
    line-height: var(--line-height-body);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    transition: color 0.3s ease, background-color 0.3s ease;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-headings);
    color: var(--color-text);
    transition: color 0.3s ease;
  }

  h1 {
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-semibold);
  }

  h2 {
    font-size: var(--font-size-h2);
    margin-bottom: var(--spacing-md);
    font-weight: var(--font-weight-medium);
  }

  h3 {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-medium);
  }

  h4 {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-medium);
  }

  h5 {
    font-size: var(--font-size-h4);
  }

  h6 {
    font-size: var(--font-size-h6);
  }

  p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-0);
    line-height: var(--line-height-body);
    transition: color 0.3s ease;
  }

  ul, ol {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-0);
    line-height: var(--line-height-body);
    transition: color 0.3s ease;
  }

  li {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-0);
    line-height: var(--line-height-body);
    transition: color 0.3s ease;
  }

  a {
    color: var(--color-text);
    text-decoration: none;
    transition: opacity 0.2s ease, color 0.3s ease;
  }

  a:hover {
    opacity: 0.7;
  }

  /* Primary CTA — the only place coral appears as a button background.
     Used sparingly: hero, /about-me contact block. */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    padding: 0.875rem 1.5rem;
    background: var(--color-accent-coral);
    color: #FFFFFF;
    border-radius: var(--radius-pill);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-ui-lg);
    border: none;
    cursor: pointer;
    transition: background-color var(--transition-fast), transform 0.1s ease;
  }

  .btn-primary:hover {
    background: var(--color-accent-coral-hover);
    color: #FFFFFF;
    opacity: 1;
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  section {
    padding: var(--spacing-md) 0;
    transition: background-color 0.3s ease;
  }

  [data-aos] {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  /* Custom AOS fade-up with larger upward movement */
  [data-aos="fade-up"] {
    transform: translate3d(0, 50px, 0);
  }

  [data-aos="fade-up"].aos-animate {
    transform: translate3d(0, 0, 0);
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 1.5rem;
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius-pill);
    font-weight: var(--font-weight-semibold);
    transition: opacity var(--transition-fast), transform 0.1s ease;
    border: none;
    cursor: pointer;
    font-size: var(--font-size-ui-lg);
  }

  .btn:hover {
    opacity: 0.85;
    color: var(--color-bg);
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-bg-secondary);
    color: var(--color-text);
    opacity: 1;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  .float-animation {
    animation: float 3s ease-in-out infinite;
  }

  @media (max-width: 768px) {
    section {
      padding: var(--spacing-lg) 0;
    }

    .container {
      padding: 0 var(--spacing-sm);
    }
  }
</style>
