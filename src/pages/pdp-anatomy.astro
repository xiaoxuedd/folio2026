---
import Layout from '../layouts/Layout.astro';
import PdpModuleAnatomy from '../components/PdpModuleAnatomy.astro';
---

<!--
  Isolated preview for the "PDP Module Anatomy" infographic (design_handoff_pdp_module_anatomy).
  Not linked from anywhere — a scratch route to develop the component on its own
  before it's wired into Module 02 of the e-commerce case study. Safe to delete on
  integration.

  Fonts: the diagram is a deliberate mono "technical wireframe" treatment in IBM
  Plex Mono only (the handoff update dropped the Cormorant display title). It isn't
  self-hosted in the project yet, so this scratch page pulls it from Google Fonts.
  When integrating for real, decide whether to self-host via @fontsource.
-->
<Layout title="PDP Module Anatomy — preview">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <main class="pma-preview">
    <div class="pma-preview__inner">
      <p class="pma-preview__eyebrow">Component preview</p>
      <h1>PDP Module Anatomy</h1>
      <p class="pma-preview__note">
        Top: a mock of how this will sit in <code>/ecommerce</code> <strong>Workstream 02</strong>
        — a 4:3 window that slowly pans the diagram top → bottom → top (pauses at each end,
        pauses on hover, static under reduced-motion). Below: the full-size component at
        <code>Standard</code> then <code>Compact</code> density for reference.
      </p>

      <!-- ── Module 02 in-context preview: mirrors the case study's .solution-row
           (4:3 media box + body copy). The window pans the (scaled-down) diagram. ── -->
      <div class="pma-preview__variant">
        <span class="pma-preview__variant-label">Module 02 — windowed, in context</span>
        <div class="m2-row">
          <div class="pma-window" data-pma-window>
            <div class="pma-window__pan">
              <div class="pma-window__scale">
                <PdpModuleAnatomy density="Standard" />
              </div>
            </div>
          </div>
          <div class="m2-body">
            <span class="m2-eyebrow">Workstream 02</span>
            <h3>Anatomy of a luxury PDP</h3>
            <p>
              Placeholder body copy. In the case study this column carries the workstream
              narrative — what the structure revealed and why it mattered. The diagram beside
              it is the visual evidence: every module mapped top to bottom, each bar sized by
              its real vertical footprint on the page.
            </p>
            <div class="m2-impact">
              <span class="m2-impact__label">Key insight</span>
              <span class="m2-impact__value">
                A luxury PDP is a twelve-module stack, front-loaded for conversion.
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="pma-preview__variant">
        <span class="pma-preview__variant-label">Full size — Standard</span>
        <PdpModuleAnatomy density="Standard" />
      </div>

      <div class="pma-preview__variant">
        <span class="pma-preview__variant-label">Full size — Compact</span>
        <PdpModuleAnatomy density="Compact" />
      </div>
    </div>
  </main>
</Layout>

<script>
  // Fit + pan driver for the windowed preview. The diagram has a fixed natural width,
  // so we scale it to the box width and expose the vertical overflow as a CSS var the
  // keyframe animation pans across. Re-runs on resize and after fonts load. Portable to
  // the real (fluid, 50%-width) Module 02 slot — it reads the box width at runtime.
  function setupPmaWindow(box: HTMLElement) {
    const scale = box.querySelector<HTMLElement>('.pma-window__scale');
    if (!scale) return;

    const fit = () => {
      scale.style.transform = 'none'; // reset so we measure the natural size
      const naturalW = scale.offsetWidth;
      const naturalH = scale.offsetHeight;
      if (!naturalW) return;
      const k = box.clientWidth / naturalW;
      scale.style.transform = `scale(${k})`;
      const dist = Math.max(0, naturalH * k - box.clientHeight);
      box.style.setProperty('--pma-pan-distance', `${dist}px`);
    };

    fit();
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(fit).observe(box);
    else window.addEventListener('resize', fit);
    if (document.fonts?.ready) document.fonts.ready.then(fit);
  }

  document
    .querySelectorAll<HTMLElement>('[data-pma-window]')
    .forEach(setupPmaWindow);
</script>

<style>
  .pma-preview {
    min-height: 100vh;
    padding: var(--spacing-lg) var(--spacing-md);
  }

  .pma-preview__inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .pma-preview__eyebrow {
    font-size: var(--font-size-ui-xs, 0.75rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--gap-sm);
  }

  .pma-preview h1 {
    font-size: var(--font-size-h3);
    margin-bottom: var(--gap-sm);
  }

  .pma-preview__note {
    color: var(--text-2);
    margin-bottom: var(--spacing-lg);
  }

  .pma-preview__note code {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85em;
  }

  .pma-preview__variant {
    margin-bottom: var(--spacing-lg);
  }

  .pma-preview__variant-label {
    display: block;
    font-size: var(--font-size-ui-xs, 0.75rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: var(--gap-sm);
  }

  /* ── Module 02 in-context mock — mirrors .solution-row from ecommerce.astro ── */
  .m2-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
  }

  /* The 4:3 window: same chrome as the case study's .solution-media. */
  .pma-window {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    overflow: hidden;
    background: var(--surface-2);
  }

  /* Animated layer — pans the scaled diagram. Distance is set per-box by the script. */
  .pma-window__pan {
    width: max-content;
    animation: pma-pan 16s ease-in-out infinite;
    will-change: transform;
  }

  /* Scaled layer — shrunk to the box width by the script (origin top-left). */
  .pma-window__scale {
    width: max-content;
    transform-origin: top left;
  }

  /* The window provides the rounded corners; drop the diagram's own radius inside. */
  .pma-window :global(.pma) {
    border-radius: 0;
  }

  @keyframes pma-pan {
    0%,
    12% {
      transform: translateY(0);
    }
    44%,
    60% {
      transform: translateY(calc(var(--pma-pan-distance, 0px) * -1));
    }
    92%,
    100% {
      transform: translateY(0);
    }
  }

  /* Let the viewer stop the pan to inspect. */
  .pma-window:hover .pma-window__pan {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .pma-window__pan {
      animation: none;
      transform: none;
    }
  }

  .m2-eyebrow {
    display: block;
    font-size: var(--font-size-ui-sm, 0.875rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--spacing-sm);
  }

  .m2-body h3 {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-tight, 1.15);
    margin-bottom: var(--spacing-md);
  }

  .m2-body p {
    font-size: var(--font-size-body-0);
    color: var(--text-2);
    line-height: var(--line-height-body, 1.65);
    margin-bottom: var(--spacing-lg);
    max-width: 46ch;
  }

  .m2-impact {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--spacing-sm) var(--spacing-md);
    border-left: 2px solid var(--accent);
    background: var(--surface-2);
    border-radius: 0 var(--radius-sm, 6px) var(--radius-sm, 6px) 0;
  }

  .m2-impact__label {
    font-size: var(--font-size-ui-xs, 0.75rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .m2-impact__value {
    font-size: var(--font-size-body-0);
    color: var(--text);
    font-weight: var(--font-weight-medium, 500);
  }

  @media (max-width: 768px) {
    .m2-row {
      grid-template-columns: 1fr;
    }
  }
</style>
