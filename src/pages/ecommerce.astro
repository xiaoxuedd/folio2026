---
import Layout from '../layouts/Layout.astro';
import ProjectNavigation from '../components/ProjectNavigation';
import CircleTitle from '../components/CircleTitle.astro';
import InteractiveJourneyMap from '../components/InteractiveJourneyMap';
import ReturnVoicesCards from '../components/ReturnVoicesCards';
import ProblemStats from '../components/ProblemStats';
import ImpactBento, { type BentoStat } from '../components/ImpactBento';
import NextProjectButton from '../components/NextProjectButton';
import ReturnReasonVenn from '../components/ReturnReasonVenn';
import PdpModuleAnatomy from '../components/PdpModuleAnatomy.astro';
import Footer from '../components/Footer.astro';
import { Image, getImage } from 'astro:assets';
import { HardHat, BrainCircuit, ArrowLeftRight } from 'lucide-react';

// Interactive journey map images.
import journeyMapBottom from '../images/projects/journey-map-bottom-full.jpg';
import journey1 from '../images/projects/return-journey-1.jpg';
import journey2 from '../images/projects/return-journey-2.jpg';
import journey3 from '../images/projects/return-journey-3.jpg';

// Scalable-solutions module images.
import modulePDP from '../images/projects/ecommerce-returns.jpg';
import pdpFlowMap from '../images/projects/pdp-size-flow-map.jpg';

// Statement-band backdrop — a cropped parcel image behind the opening question.
import statementBg from '../images/projects/ecommerce-banner-2.jpg';

const baseUrl = import.meta.env.BASE_URL;

// --- The Problem: interactive stat callouts -------------------------------
const problemStats = [
  {
    figure: 3,
    suffix: '×',
    label: 'higher apparel returns online than in store',
    source: 'Industry benchmark · 2024',
  },
  {
    figure: 27,
    suffix: '%',
    label: 'of the purchase price just to process a return\n— up to 50% of its margin',
    source: 'Optoro · 2024 Returns Unwrapped · Nov 2024',
  },
  {
    figure: 75,
    suffix: '%',
    label: 'of unsaleable UK returns hit landfill\n— 23M items, 750K tonnes CO₂ a year',
    source: 'British Fashion Council / DHL / Roland Berger · Solving Fashion’s Product Returns · Mar 2023',
  },
];

// --- The problem beneath the brief: interactive journey map ---------------
const [seg1Img, seg2Img, seg3Img, journeyBottomImg, pdpMapImg] = await Promise.all([
  getImage({ src: journey1, format: 'webp', quality: 85 }),
  getImage({ src: journey2, format: 'webp', quality: 85 }),
  getImage({ src: journey3, format: 'webp', quality: 85 }),
  getImage({ src: journeyMapBottom, format: 'webp', quality: 82 }),
  getImage({ src: pdpFlowMap, format: 'webp', quality: 82 }),
]);

// --- Scalable solutions ---------------------------------------------------
const solutions = [
  {
    module: '01',
    title: 'Redesigning the return signal',
    body: '“Just unsuitable.” Technically, a reason; practically, useless. So we rebuilt the moment itself: design a return flow that collects genuinely useful data, not just what customers were willing to say, but what the business actually needed to know. We redesigned the flow, validated the language, and introduced mindful friction, improving data quality without damaging the experience.',
    impact: '£300M of orders a year came back with a reason that told us nothing',
  },
  {
    module: '02',
    title: 'Helping customers buy right the first time',
    body: 'I guided the team to understand the mental models behind purchase decisions: how curiosity, consideration, and confidence shift by category. We mapped those needs to a modular, category-adaptable PDP architecture tied to commercial KPIs, giving teams a system built for the best-informed purchase decision.',
    impact: 'A £3,000 engagement ring and a £15 eyeshadow, on the same static PDP.',
  },
  {
    module: '03',
    title: 'Fix the data at the root',
    body: 'I unpacked how that data actually moved, then redesigned the workflow so accuracy got built in upstream rather than fixed downstream, pairing the new process with AI-driven size recommendations and action cards that clarified ownership and sequencing across the 10+ teams who touched it.',
    impact: '50+ data points behind a single pair of trainers, entered manually across different teams.',
  },
];

// --- Impact ---------------------------------------------------------------
const impactStats: BentoStat[] = [
  {
    variant: 'lead',
    eyebrow: 'Pilot phase',
    number: 10,
    suffix: '%',
    title: 'Return reduction',
    description:
      'The programme’s contribution to returns, measured during the 12-week pilot phase.',
  },
  { variant: 'side', value: '6×', title: 'Conversion uplift, with smart size-tool engagement' },
  { variant: 'side', number: 80, suffix: '%', title: 'Reduction in manual data correction' },
  { variant: 'wide', number: 50, suffix: '%', title: 'Improvement in data utilisation' },
  { variant: 'wide', value: '10+', title: 'Functions trained and prepared for migration' },
];

// --- After thoughts -------------------------------------------------------
const reflections = [
  {
    icon: HardHat,
    title: 'The warehouse taught me more than any workshop.',
    description:
      'We didn’t just guess what the team needed; we shadowed quality checks in the warehouse and handled high-stakes VIP returns in customer service. By jumping into their daily grind and respecting their learning curves, we stopped designing <em>for</em> them and started co-creating <em>with</em> teams and functions as fellow experts. That’s how you turn tech anxiety into genuine team synergy.',
  },
  {
    icon: BrainCircuit,
    title: 'Tech can’t rescue a process nobody understands',
    description:
      'Before touching a single model, we had to trace exactly how data moved through the business: who entered it, where it broke down, and why the workarounds existed. Introducing AI was the easier problem. Getting 10+ teams to agree on how a size should be recorded and surfaced was the design challenge worth solving.',
  },
];
---

<Layout title="Happier customers, healthier business - Xiaoxue">
  <!-- IBM Plex Mono powers the Module 02 PDP-anatomy diagram (mono "wireframe"
       treatment). TODO: self-host via @fontsource/ibm-plex-mono to match the repo
       convention rather than this Google Fonts link. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <ProjectNavigation client:load />

  <div class="project-page">
    <!-- 1. Context / hero -->
    <div class="container">
      <section id="context" class="hero-section">
        <h1 data-aos="fade-up">Happier customers, healthier business</h1>
        <h2 class="subtitle" data-aos="fade-up" data-aos-delay="150">
          A cross-functional approach to one of fashion’s most expensive habits
        </h2>
      </section>
    </div>

    <!-- Editorial statement band — cropped parcel image behind the question -->
    <div class="container">
      <section class="statement-band" data-aos="fade-up" data-aos-delay="350">
        <div class="statement-band__media">
          <Image
            src={statementBg}
            alt=""
            widths={[768, 1280, 1920]}
            sizes="100vw"
            format="webp"
            quality={70}
          />
        </div>
        <div class="statement-band__scrim" aria-hidden="true"></div>
        <p class="statement">
          When was the last time you returned something bought online?
        </p>
      </section>
    </div>

    <!-- 2. The problem / the goal -->
    <div class="container">
      <section id="challenge" class="problem-section" data-aos="fade-up">
        <h2 class="problem-heading">Background</h2>
        <p class="problem-lead">
          Fashion retail has a returns problem that’s only getting harder to ignore. Online
          shoppers do something in-store customers never could: order three sizes, keep the one
          that fits, send the rest back, a habit the industry calls <em>bracketing</em>.
          Multiply that across an industry, and the bill comes due twice.
          <strong>Once in dollars,</strong> processing a single return can erase up to half its
          profit margin. <strong>And once in carbon,</strong> millions of garments are tried
          on, sent back, and burned or buried every year, simply because the size guess didn’t
          land.
        </p>
        <div class="problem-grid">
          <ProblemStats stats={problemStats} client:visible />
          <aside
            class="quote-flip"
            tabindex="0"
            aria-label="Two sides of the same problem — hover, tap, or focus to flip"
          >
            <div class="quote-flip__inner">
              <div class="quote-flip__face quote-flip__front">
                <span class="quote-flip-affordance" aria-hidden="true">
                  <ArrowLeftRight size={20} strokeWidth={1.75} />
                </span>
                <span class="eyebrow">Customer side</span>
                <p class="quote-flip__prose">
                  You can’t try it on, you can’t feel the fabric, and the size guide is lying to
                  you. Ordering multiples isn’t abuse, it’s the only sensible response to a system
                  that hasn’t solved the basics yet.
                </p>
              </div>
              <div class="quote-flip__face quote-flip__back">
                <span class="quote-flip-affordance" aria-hidden="true">
                  <ArrowLeftRight size={20} strokeWidth={1.75} />
                </span>
                <span class="eyebrow">Business side</span>
                <p class="quote-flip__back-body">
                  Free returns were a promise made to earn trust in a competitive market, now
                  they’re honoured as default, whether it converts or not. For a luxury retailer,
                  that math is quietly brutal.
                </p>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <!-- Role & mandate -->
      <section class="info-section" data-aos="fade-up">
        <div class="info-column">
          <CircleTitle text="Role & Responsibility" circleId="1" />
          <p><strong>Client:</strong> Net-A-Porter</p>
          <p><strong>Sector:</strong> Luxury Fashion E-commerce</p>
          <p><strong>Duration:</strong> 6–12 months</p>
          <p><strong>Role:</strong> Service Design Lead</p>
        </div>
        <div class="info-column">
          <CircleTitle text="My Mandate" circleId="2" />
          <p>
            <strong>The brief from the CFO was direct: reduce return rates by 40% within the coming
            quarter.</strong>
          </p>
          <p>
            My mandate was to give the business a holistic view of returns, surfacing where the
            real opportunity lived, across both business and design, end to end, and to build the
            programme that would let teams actually own and act on it.
          </p>
        </div>
      </section>

      <!-- 3. The problem beneath the brief (returns map + three cards) -->
      <section id="execution" class="beneath-section" data-aos="fade-up">
        <header class="section-head">
          <span class="eyebrow">Unpack the challenge</span>
          <h2>The problem beneath the brief</h2>
          <p class="section-intro">
            The CFO’s target was clear. What wasn’t clear was where to start, because the business
            had never agreed on what the problem actually was. That disagreement was the real
            challenge. Not the returns themselves, but an organisation that couldn’t act on a
            problem it hadn’t defined together. That’s what I was actually there to solve.
          </p>
        </header>

        <ReturnVoicesCards client:visible />

        <InteractiveJourneyMap
          seg1={{ src: seg1Img.src, srcset: seg1Img.srcSet.attribute }}
          seg2={{ src: seg2Img.src, srcset: seg2Img.srcSet.attribute }}
          seg3={{ src: seg3Img.src, srcset: seg3Img.srcSet.attribute }}
          bottomSrc={journeyBottomImg.src}
          client:visible
        />
      </section>
    </div>

    <!-- 4. Scalable solutions (surface band, alternating rows) -->
    <section class="solutions-section" data-aos="fade-up">
      <div class="container">
        <h2 class="solutions-heading">Scalable solutions</h2>
        {
          solutions.map((solution, index) => (
            <article
              class:list={['solution-row', { 'solution-row--reverse': index % 2 === 1 }]}
              data-aos="fade-up"
            >
              <div
                class:list={['solution-media', {
                  'solution-media--svg': solution.module === '01',
                  'solution-media--pdp': solution.module === '02',
                  'solution-media--flow': solution.module === '03',
                }]}
                data-pma-window={solution.module === '02' ? '' : undefined}
              >
                {solution.module === '01' ? (
                  <ReturnReasonVenn client:visible />
                ) : solution.module === '02' ? (
                  <div class="pma-window__pan">
                    <div class="pma-window__scale">
                      <PdpModuleAnatomy density="Standard" />
                    </div>
                  </div>
                ) : solution.module === '03' ? (
                  <div class="sfz-stage">
                    <img class="sfz-map" src={pdpMapImg.src} alt="Size and fit data-flow map across teams and tooling" loading="lazy" />
                    <div class="sfz-vignette" aria-hidden="true" />
                    {/* Crisp "Product measurements" detail — faithful reproduction
                        of the case-study artifact; colours are part of that artwork. */}
                    <div class="sfz-groupwrap" aria-hidden="true">
                      <div class="sfz-group">
                        <div class="sfz-cards">
                          <div class="sfz-card">
                            <span class="sfz-bulb">💡</span>
                            <div class="sfz-card-title">Knowledge sharing</div>
                            <div class="sfz-card-body">Share Size and Fit relevant information with DC measurement team to help streamline the process</div>
                          </div>
                          <div class="sfz-card">
                            <span class="sfz-bulb">💡</span>
                            <div class="sfz-card-title">Simplification</div>
                            <div class="sfz-card-body">Simplify measurements and guidelines for different categories</div>
                          </div>
                          <div class="sfz-card">
                            <span class="sfz-bulb">💡</span>
                            <div class="sfz-card-title">DC Collaboration</div>
                            <div class="sfz-card-body">Distribution centre coordination and efficiency (e.g. Shared worklists between DCs)</div>
                          </div>
                        </div>
                        <div class="sfz-init">
                          <div class="sfz-init-main"><span>Initiatives:</span> Refine valuable size information</div>
                          <div class="sfz-init-owner"><span>Owner:</span> EXP, DC &amp; PO</div>
                        </div>
                      </div>
                    </div>
                  </div>
                ) : (
                  <Image
                    src={modulePDP}
                    alt={solution.title}
                    widths={[480, 768, 1024]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                    format="webp"
                    quality={80}
                  />
                )}
              </div>
              <div class="solution-body">
                <span class="eyebrow">Workstream {solution.module}</span>
                <h4>{solution.title}</h4>
                <p>{solution.body}</p>
                <div class="key-impact">
                  <span class="key-impact__label">Key insight</span>
                  <span class="key-impact__value">{solution.impact}</span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 5. Impact (always-dark, full-bleed bento) -->
    <section id="impact" class="impact-section" data-aos="fade-up">
      <div class="container">
        <h2 class="impact-heading">Impact</h2>
        <ImpactBento stats={impactStats} client:visible />
      </div>
    </section>

    <!-- 6. After thoughts -->
    <div class="container">
      <section id="reflection" class="reflections-section" data-aos="fade-up">
        <h2>Afterthoughts</h2>
        <div class="reflections-grid">
          {
            reflections.map((reflection) => {
              const Icon = reflection.icon;
              return (
                <div class="reflection-card">
                  <div class="reflection-icon">
                    <Icon size={24} strokeWidth={1.75} />
                  </div>
                  <h3>{reflection.title}</h3>
                  <p set:html={reflection.description} />
                </div>
              );
            })
          }
        </div>
      </section>

      <!-- Footer CTA -->
      <section class="footer-cta" data-aos="fade-up">
        <NextProjectButton
          href={`${baseUrl}healthcare`.replace(/\/\//g, '/')}
          projectTitle="Healthcare"
          accent="mint"
          client:visible
        />
      </section>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { trackEvent } from '../utils/analytics';

  // One-shot scroll-depth milestones for this case study (aggregate only).
  function setupReadDepthTracking() {
    const milestones = [25, 50, 75, 100];
    const fired = new Set<number>();
    let ticking = false;

    const check = () => {
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return;
      const percent = (window.pageYOffset / scrollable) * 100;

      milestones.forEach((m) => {
        if (percent >= m && !fired.has(m)) {
          fired.add(m);
          trackEvent('case_study_scroll', { project: 'ecommerce', depth: m });
        }
      });

      if (fired.size === milestones.length) {
        window.removeEventListener('scroll', onScroll);
      }
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          check();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    check();
  }

  // Animate the hand-drawn circle titles on scroll (mirrors healthcare.astro).
  function setupCircleTitleAnimations() {
    const circleTitles = document.querySelectorAll('.circle-title[data-circle-id]');

    circleTitles.forEach((title) => {
      const path = title.querySelector('.circle-path') as SVGPathElement;
      if (!path) return;

      const pathLength = 470;
      path.style.strokeDasharray = `${pathLength}`;
      path.style.strokeDashoffset = `${pathLength}`;

      const handleScroll = () => {
        const rect = title.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        const startTrigger = windowHeight * 0.85;
        const endTrigger = windowHeight * 0.75;

        let progress = 0;
        if (rect.top <= startTrigger && rect.top >= endTrigger) {
          const totalDistance = startTrigger - endTrigger;
          const currentDistance = startTrigger - rect.top;
          progress = Math.max(0, Math.min(1, currentDistance / totalDistance));
        } else if (rect.top > startTrigger) {
          progress = 0;
        } else {
          progress = 1;
        }

        const offset = pathLength * (1 - progress);
        path.style.strokeDashoffset = `${offset}`;
        path.style.transition = 'stroke-dashoffset 0.3s ease-out';
      };

      handleScroll();

      let ticking = false;
      const scrollHandler = () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            handleScroll();
            ticking = false;
          });
          ticking = true;
        }
      };

      window.addEventListener('scroll', scrollHandler, { passive: true });
      window.addEventListener('resize', handleScroll);
    });
  }

  // Subtle parallax on the opening statement image.
  function setupStatementParallax() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const band = document.querySelector('.statement-band');
    const media = document.querySelector<HTMLElement>('.statement-band__media');
    if (!band || !media) return;

    // Media is inset -12% top/bottom (24% extra height) — drift within that.
    const MAX_SHIFT = 0.1; // fraction of band height
    let ticking = false;

    const update = () => {
      const rect = band.getBoundingClientRect();
      const vh = window.innerHeight;
      // progress: 0 when band enters from bottom, 1 when it leaves at top.
      const progress = (vh - rect.top) / (vh + rect.height);
      const clamped = Math.max(0, Math.min(1, progress));
      const shift = (clamped - 0.5) * 2 * MAX_SHIFT * rect.height;
      media.style.transform = `translate3d(0, ${shift}px, 0)`;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          update();
          ticking = false;
        });
        ticking = true;
      }
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
  }

  // Module 02 windowed diagram: scale the fixed-width PdpModuleAnatomy to the media
  // box width and expose its vertical overflow as a CSS var the pan keyframes travel.
  function setupPmaWindow(box: HTMLElement) {
    const scale = box.querySelector<HTMLElement>('.pma-window__scale');
    if (!scale) return;
    const fit = () => {
      scale.style.transform = 'none';
      const naturalW = scale.offsetWidth;
      const naturalH = scale.offsetHeight;
      if (!naturalW) return;
      const k = box.clientWidth / naturalW;
      scale.style.transform = `scale(${k})`;
      const dist = Math.max(0, naturalH * k - box.clientHeight);
      box.style.setProperty('--pma-pan-distance', `${dist}px`);
    };
    fit();
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(fit).observe(box);
    else window.addEventListener('resize', fit);
    if (document.fonts?.ready) document.fonts.ready.then(fit);
  }

  // Opening question: split into words and reveal them in a rising stagger when
  // the band scrolls in. Progressive enhancement — plain text stays visible if
  // this never runs; reduced-motion shows everything at once.
  function setupStatementReveal() {
    const el = document.querySelector<HTMLElement>('.statement');
    if (!el || el.dataset.revealed === 'true') return;
    el.dataset.revealed = 'true';

    const words = (el.textContent ?? '').trim().split(/\s+/);
    el.textContent = '';
    // The band image fades up via AOS: 350ms delay + 800ms duration ≈ 1.15s to
    // fully land. Hold the words until then so the text is clearly the last
    // thing in — titles → image → text.
    const BASE_DELAY = 1.35;
    words.forEach((word, i) => {
      const span = document.createElement('span');
      span.className = 'statement__word';
      span.textContent = word;
      span.style.transitionDelay = `${BASE_DELAY + i * 0.06}s`;
      el.appendChild(span);
      if (i < words.length - 1) el.appendChild(document.createTextNode(' '));
    });

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.classList.add('is-revealed');
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            el.classList.add('is-revealed');
            io.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );
    io.observe(el);
  }

  // Touch-only flip card: hover/focus-within can't flip back on touch, so on
  // devices without a hover-capable pointer we drive the flip by tap — tap to
  // flip, tap again to flip back, tap outside (or Escape) to reset.
  function setupQuoteFlip() {
    const card = document.querySelector<HTMLElement>('.quote-flip');
    if (!card) return;
    if (window.matchMedia('(hover: hover)').matches) return;

    card.addEventListener('click', () => {
      card.classList.toggle('is-flipped');
    });

    document.addEventListener('click', (e) => {
      if (!card.contains(e.target as Node)) card.classList.remove('is-flipped');
    });

    card.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') card.classList.remove('is-flipped');
    });
  }

  function init() {
    setupReadDepthTracking();
    setupCircleTitleAnimations();
    setupStatementParallax();
    setupStatementReveal();
    setupQuoteFlip();
    document.querySelectorAll<HTMLElement>('[data-pma-window]').forEach(setupPmaWindow);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  setTimeout(setupCircleTitleAnimations, 500);
  setTimeout(setupCircleTitleAnimations, 1000);
</script>

<style>
  .project-page {
    background: var(--color-bg);
    padding-top: 80px;
  }

  /* Shared eyebrow label — mint, uppercase, tracked. */
  .eyebrow {
    display: inline-block;
    font-size: var(--font-size-ui-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  /* 1. Hero */
  .hero-section {
    padding: var(--spacing-lg) 0 var(--spacing-md);
  }

  .hero-section h1 {
    margin: 0 0 var(--spacing-sm);
    max-width: var(--content-width-reading);
    font-size: var(--font-size-h0);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-hero);
  }

  .hero-section .subtitle {
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-regular);
    color: var(--color-primary);
    max-width: var(--content-width-reading);
    margin: 0;
    line-height: var(--line-height-headings);
  }

  /* Opening statement — cropped parcel image, bound to content width. */
  .statement-band {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: clamp(300px, 39vh, 485px);
    margin: var(--spacing-md) 0;
    border-radius: var(--radius-lg);
  }

  /* Parallax layer — taller than the band so it can drift on scroll. */
  .statement-band__media {
    position: absolute;
    inset: -12% 0;
    will-change: transform;
  }

  .statement-band__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  /* Scrim for legibility — derived from the inverse background token. */
  .statement-band__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
